def open_browser():
    """Open browser after short delay"""
    time.sleep(1)
    try:
        subprocess.Popen(['xdg-open', f'http://localhost:{PORT_HTTP}'], 
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except:
        pass

def is_server_running():
    """Check if server is already running on our port"""
    import socket
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        sock.bind(('localhost', PORT_HTTP))
        sock.close()
        return False  # Port is free, server not running
    except OSError:
        return True  # Port in use, server already running

def main():
    # Check if already running
    if is_server_running():
        print("""
╔═══════════════════════════════════════════════════════════════════╗
║              OSCP Toolkit - Already Running!                      ║
╚═══════════════════════════════════════════════════════════════════╝
""")
        print("[✓] Server already running on port 8888")
        print("[+] Opening browser...")
        subprocess.Popen(['xdg-open', f'http://localhost:{PORT_HTTP}'], 
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        
        print("[+] Spawning new terminal window...")
        spawn_terminal_with_tmux()
        print("\nDone! You can close this window.")
        return
    
    # Normal startup
    print("""
╔═══════════════════════════════════════════════════════════════════╗
║              OSCP Toolkit                                         ║
╠═══════════════════════════════════════════════════════════════════╣
║  Browser: http://localhost:8888                                   ║
║  Commands go to your active tmux window                           ║
║  All shells start as ROOT (sudo -i)                               ║
╚═══════════════════════════════════════════════════════════════════╝
""")
    
    # Spawn terminal with tmux + root shell
    print("[+] Opening terminal with root shell...")
    spawn_terminal_with_tmux()
    
    # Open browser
    print("[+] Opening browser...")
    threading.Thread(target=open_browser, daemon=True).start()
    
    # Start server
    print(f"[+] Server running on port {PORT_HTTP}")
    print("\nPress Ctrl+C to stop\n" + "─" * 60)
    
    server = HTTPServer(('localhost', PORT_HTTP), CombinedHandler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")
        server.shutdown()

if __name__ == '__main__':
    main()

